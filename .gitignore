# ==========================================
# Urban Style — Git Ignore Rules
# ==========================================

# Build & compiled output
dist/
build/
out/
.astro/

# Dependencies
node_modules/
.pnpm-store/

# Logs & debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables & secrets
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local
!.env.example

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~
*.swp

# IDE & Editor files
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Cache & temporary files
.cache/
.parcel-cache/
.turbo/
.temp/
tmp/
